{
  "entities": {
    "PublicUserProfile": {
      "title": "PublicUserProfile",
      "description": "Publicly searchable user directory profile without PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "about": { "type": "string", "maxLength": 140 },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoURL", "about", "isOnline", "lastSeen", "updatedAt"]
    },
    "PrivateUserInfo": {
      "title": "PrivateUserInfo",
      "description": "Private user account document isolating PII such as email.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "UserInboxChat": {
      "title": "UserInboxChat",
      "description": "Per-user chat inbox summary entry for fast real-time sidebar listing.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chatType": { "type": "string", "enum": ["direct", "group", "community"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "peerUid": { "type": "string", "maxLength": 128 },
        "lastMessageText": { "type": "string", "maxLength": 300 },
        "lastMessageSenderId": { "type": "string", "maxLength": 128 },
        "lastMessageSenderName": { "type": "string", "maxLength": 60 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "unreadCount": { "type": "number" },
        "muted": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "chatId",
        "chatType",
        "title",
        "photoURL",
        "peerUid",
        "lastMessageText",
        "lastMessageSenderId",
        "lastMessageSenderName",
        "lastMessageAt",
        "unreadCount",
        "muted",
        "pinned",
        "updatedAt"
      ]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "Canonical direct, group, or community chat room metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["direct", "group", "community"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberCount": { "type": "number" },
        "lastMessageText": { "type": "string", "maxLength": 300 },
        "lastMessageSenderId": { "type": "string", "maxLength": 128 },
        "lastMessageSenderName": { "type": "string", "maxLength": 60 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "type",
        "title",
        "photoURL",
        "createdBy",
        "memberCount",
        "lastMessageText",
        "lastMessageSenderId",
        "lastMessageSenderName",
        "lastMessageAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMember": {
      "title": "ChatMember",
      "description": "Membership record controlling access to a chat room and its subcollections.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "joinedAt": { "type": "string", "format": "date-time" },
        "lastReadAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoURL", "role", "joinedAt", "lastReadAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a chat thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chatId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "text": { "type": "string", "maxLength": 2000 },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToText": { "type": "string", "maxLength": 200 },
        "replyToSender": { "type": "string", "maxLength": 60 },
        "reactions": { "type": "object" },
        "starredBy": { "type": "object" },
        "deleted": { "type": "boolean" },
        "edited": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "chatId",
        "senderId",
        "senderName",
        "text",
        "replyToId",
        "replyToText",
        "replyToSender",
        "reactions",
        "starredBy",
        "deleted",
        "edited",
        "createdAt",
        "updatedAt"
      ]
    },
    "TypingStatus": {
      "title": "TypingStatus",
      "description": "Real-time typing indicator state per chat member.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "isTyping": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "isTyping", "updatedAt"]
    }
  },
  "firestore": {
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/PublicUserProfile" },
      "description": "Publicly searchable user profiles (no PII)."
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUserInfo" },
      "description": "Private PII user account record strictly owned by userId."
    },
    "/user_inbox/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/UserInboxChat" },
      "description": "User's personal chat inbox list entries."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatRoom" },
      "description": "Chat room metadata for direct, group, and community rooms."
    },
    "/chats/{chatId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/ChatMember" },
      "description": "Chat membership records."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Chat messages subcollection."
    },
    "/chats/{chatId}/typing/{memberId}": {
      "schema": { "$ref": "#/entities/TypingStatus" },
      "description": "Ephemeral typing status indicators per member."
    }
  }
}
